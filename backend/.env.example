DATABASE_URL="sqlserver://localhost:1433;database=simula;user=sa;password=password;encrypt=true;trustServerCertificate=true"

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

INSTITUTIONAL_EMAIL_DOMAIN=@unah.edu.hn
INSTITUTIONAL_EMAIL_DOMAIN_ESTUDIANT=@unah.hn
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
PORT=3000

# HU-04-01: URL BASE del modelo predictivo, sin ruta de endpoint (el backend
# agrega /recomendaciones y /evaluacion-carga, ver
# docs/modelo-predictivo/03-decisiones-contrato.md). Vacía = recomendaciones con
# fallback local (clases disponibles del nivel sugerido) y evaluación de carga
# no disponible. Esta variable elige la implementación del motor sin
# recompilar (basta reiniciar el backend), porque el mock y el API real
# cumplen el mismo contrato:
#   mock local: http://localhost:4010/v1  (node mock-modelo-predictivo/servidor.mjs)
#   API real:   la URL base que publique el equipo del modelo
PREDICTIVE_MODEL_URL=
# Tiempo máximo de espera de cada llamada al modelo (ms). Vacía o no entera
# positiva = 3000. Al vencerse, la falla se reporta como NO_DISPONIBLE.
PREDICTIVE_MODEL_TIMEOUT_MS=3000
# Clave enviada como "Authorization: Bearer <clave>". Vacía = no se envía la cabecera.
PREDICTIVE_MODEL_API_KEY=
# HU-05-03: clave secreta del HMAC con que se seudonimiza idEstudiante antes de
# enviarlo al modelo (nunca se envía User.idUser). Vacía = clave temporal
# aleatoria: funciona, pero el seudónimo de cada estudiante cambia al reiniciar.
PREDICTIVE_MODEL_PSEUDONYM_KEY=
