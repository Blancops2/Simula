DATABASE_URL="sqlserver://localhost:1433;database=simula;user=sa;password=password;encrypt=true;trustServerCertificate=true"

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

INSTITUTIONAL_EMAIL_DOMAIN=@unah.edu.hn
INSTITUTIONAL_EMAIL_DOMAIN_ESTUDIANT=@unah.hn
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
PORT=3000

# HU-04-01: URL BASE del modelo predictivo, sin ruta de endpoint (el backend
# agrega /recomendaciones y /evaluacion-carga, ver
# docs/modelo-predictivo/03-decisiones-contrato.md). Vacía = recomendaciones con
# fallback local (clases disponibles del nivel sugerido) y evaluación de carga
# no disponible. Ej. con el mock local: http://localhost:4010/v1
PREDICTIVE_MODEL_URL=
# Tiempo máximo de espera de cada llamada al modelo (ms).
PREDICTIVE_MODEL_TIMEOUT_MS=3000
# Clave enviada como "Authorization: Bearer <clave>". Vacía = no se envía la cabecera.
PREDICTIVE_MODEL_API_KEY=
